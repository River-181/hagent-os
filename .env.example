# OpenAI / Codex
# If you use Codex qauth, run `codex login` and you may leave OPENAI_API_KEY empty.
OPENAI_API_KEY=sk-...

# Claude fallback
ANTHROPIC_API_KEY=sk-ant-...

# Korean law MCP
LAW_OC=your-law-api-key

# Google Calendar
GOOGLE_CALENDAR_ACCESS_TOKEN=

# Kakao Channel / OpenBuilder
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
KAKAO_BOT_ID=
KAKAO_CHANNEL_SEARCH_ID=
KAKAO_OUTBOUND_PROVIDER_URL=
KAKAO_OUTBOUND_PROVIDER_TOKEN=

# Database (leave empty for embedded-postgres auto-start)
DATABASE_URL=

# Server
PORT=3100

# Deployment mode: local_trusted | authenticated
DEPLOYMENT_MODE=local_trusted
